{
  "name": "pfis-root",
  "version": "1.0.0",
  "description": "Patient Friction Intelligence System (PFIS) - Non-clinical Healthcare Accessibility Platform",
  "private": true,
  "scripts": {
    "postinstall": "cd client && npm install",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "typecheck": "cd server && npm run typecheck && cd ../client && npm run typecheck",
    "lint": "npm run typecheck",
    "test": "cd server && npm test",
    "seed": "cd server && npm run seed:demo",
    "seed:demo": "cd server && npm run seed:demo",
    "reset:demo": "cd server && npm run reset:demo",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
