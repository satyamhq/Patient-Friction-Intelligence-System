{
  "name": "pfis-server",
  "version": "1.0.0",
  "description": "PFIS Backend API and Intelligence Core",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "pretest": "tsc",
    "test": "node tests/intelligence_test.js",
    "test:integration": "node tests/verify_platform_functions.js",
    "test:rebuild": "node tests/verify_full_rebuild.js",
    "seed": "tsx src/seed/seedDemoData.ts",
    "seed:demo": "tsx src/seed/seedDemoData.ts",
    "reset:demo": "tsx src/seed/resetDemoData.ts",
    "seed:500": "tsx src/seed/seed500.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/mongodb": "^4.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
